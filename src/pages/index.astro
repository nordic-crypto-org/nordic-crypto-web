---
import App from "../App"
import "../index.css"
import { fallbackHomepageData, getHomepageData } from "../lib/api"

const initialData = await getHomepageData().catch(() => fallbackHomepageData)
---

<!doctype html>
<html lang="nn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Uavhengige nyheiter om bitcoin, blokkjede og krypto i Norden."
    />
    <meta name="theme-color" content="#193944" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Nordic Crypto — Krypto i Norden utan støy</title>
  </head>
  <body>
    <App
      client:load
      initialData={initialData}
    />
  </body>
</html>
